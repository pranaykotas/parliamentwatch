# Streamlit Cloud secrets — copy this to .streamlit/secrets.toml locally,
# and paste each key into the Streamlit Cloud "Secrets" panel.

# LLM configuration — server-side key so visitors don't need to bring their own.
# Groq free tier: https://console.groq.com/keys
LLM_PROVIDER = "openai"
LLM_API_KEY = "your-groq-api-key-here"
LLM_MODEL = "openai/gpt-oss-120b"
LLM_BASE_URL = "https://api.groq.com/openai/v1"

# Email notifications (optional — leave blank to disable)
NOTIFICATION_EMAIL = ""
SENDER_EMAIL = ""
SMTP_SERVER = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_USERNAME = ""
SMTP_PASSWORD = ""

# Lok Sabha number (default: 18)
# LOK_SABHA_NUMBER = "18"
